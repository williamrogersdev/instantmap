---
import { staticUrl } from "instantmap/server";
import { center, listings, zoom } from "../lib/listings";

const src = import.meta.env.PUBLIC_INSTANTMAP_SRC ?? "https://instantmap.org";
const poster = staticUrl({ src, center, zoom, width: 1280, height: 720, ratio: 2, markers: listings });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Instant Map in Astro</title>
  </head>
  <body style="margin:0;font-family:system-ui">
    <main style="max-width:1100px;margin:0 auto;padding:24px">
      <h1>Austin stays</h1>
      <instant-map id="map" center={center.join(",")} zoom={zoom} src={src} style="display:block;position:relative;height:520px">
        <img
          src={poster}
          alt="Map of Austin with 200 stays"
          width="1280"
          height="720"
          fetchpriority="high"
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
        />
      </instant-map>
    </main>
    <script>
      import { defineInstantMap } from "instantmap";
      import { listings } from "../lib/listings";

      defineInstantMap();

      const map = document.querySelector("instant-map");
      if (map) map.markers = listings;
    </script>
  </body>
</html>
