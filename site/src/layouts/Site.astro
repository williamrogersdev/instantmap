---
import "../styles/site.css";
import { NAV, REPO, SHARE_IMAGE, SITE } from "../data/site.ts";

interface Props {
  /** Page title, without the site name. */
  title: string;
  description: string;
  /** Path with leading and trailing slash, for example "/speed/". */
  path: string;
  /** Float the header over a full-bleed hero. */
  overlay?: boolean;
  /** Images to fetch before anything else. */
  preload?: { href: string; media?: string }[];
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

const { title, description, path, overlay = false, preload = [], schema = [] } = Astro.props;
const home = path === "/";
const fullTitle = home ? title : `${title} | Instant Map`;
const canonical = new URL(path, SITE).href;
const crumbs = home
  ? []
  : [
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Instant Map", item: `${SITE}/` },
          { "@type": "ListItem", position: 2, name: title, item: canonical },
        ],
      },
    ];
const page = { "@context": "https://schema.org", "@type": "WebPage", name: fullTitle, description, url: canonical, isPartOf: { "@type": "WebSite", name: "Instant Map", url: `${SITE}/` } };
// "<" is escaped so no text inside the data can close the script element.
const json = (data: unknown): string => JSON.stringify(data).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f2233" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Instant Map" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SHARE_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A map of San Francisco with price markers, drawn by Instant Map" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SHARE_IMAGE} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preload.map((image) => <link rel="preload" as="image" href={image.href} fetchpriority="high" media={image.media} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Instant Map documentation for language models" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="module" src="/instant-map.js"></script>
    {[page, ...crumbs, ...schema].map((data) => <script type="application/ld+json" set:html={json(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={["bar", { overlay }]}>
      <a class="brand" href="/" aria-label="Instant Map home">
        <img src="/favicon.svg" alt="" width="28" height="28" />
        Instant Map
      </a>
      <nav aria-label="Main">
        {NAV.map((item) => <a href={item.href} aria-current={item.href === path ? "page" : undefined}>{item.label}</a>)}
        <a href={REPO}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <p>
        Instant Map is open source under the MIT licence. Map data © OpenStreetMap contributors. Listings shown on this
        site are made up.
      </p>
      <div>
        <h2>Product</h2>
        <ul>
          <li><a href="/speed/">Speed</a></li>
          <li><a href="/benchmarks/">Benchmarks</a></li>
          <li><a href="/styling/">Styling and brand colours</a></li>
          <li><a href="/cards/">Cards</a></li>
          <li><a href="/frameworks/">Frameworks</a></li>
        </ul>
      </div>
      <div>
        <h2>Docs</h2>
        <ul>
          <li><a href="/docs/start/quick-start/">Quick start</a></li>
          <li><a href="/docs/start/how-it-works/">How it works</a></li>
          <li><a href="/docs/reference/element/">API reference</a></li>
          <li><a href="/docs/guides/self-hosting/">Self-hosting</a></li>
          <li><a href="/docs/start/faq/">Questions and answers</a></li>
        </ul>
      </div>
      <div>
        <h2>For AI agents</h2>
        <ul>
          <li><a href="/ai/">Agent prompt</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/llms-full.txt">llms-full.txt</a></li>
          <li><a href={REPO}>Source on GitHub</a></li>
        </ul>
      </div>
    </footer>

    <script>
      import { setupCopyButtons } from "../scripts/shared.ts";
      setupCopyButtons();
    </script>
  </body>
</html>
