---
import { staticUrl } from "instantmap/server";
import Site from "../layouts/Site.astro";
import { sanFranciscoListings } from "../data/listings.ts";
import { AGENT_PROMPT, FAQ, kb, REPO, SHARE_IMAGE, SITE, sizes, VERSION } from "../data/site.ts";

const HERO_CENTER: [number, number] = [-122.4295, 37.7668];
const listings = sanFranciscoListings(280);
const heroPoster = staticUrl({ src: "", center: HERO_CENTER, zoom: 13, width: 1280, height: 800, ratio: 2, markers: listings });
const phonePoster = staticUrl({ src: "", center: [-122.4135, 37.7625], zoom: 13, width: 400, height: 320, ratio: 2, markers: listings });

const description = "Instant Map is an open-source map for the web. It shows as one finished image before any JavaScript runs, then becomes an interactive map on first touch. One web component for every framework.";
const schema = [
  { "@context": "https://schema.org", "@type": "WebSite", name: "Instant Map", url: `${SITE}/`, description },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Instant Map",
    description,
    url: `${SITE}/`,
    image: SHARE_IMAGE,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Map component",
    operatingSystem: "Any (web browser)",
    softwareVersion: VERSION,
    license: "https://opensource.org/licenses/MIT",
    codeRepository: REPO,
    downloadUrl: "https://www.npmjs.com/package/instantmap",
    softwareHelp: `${SITE}/docs/start/quick-start/`,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: ["First view is a server-rendered image", "Interactive map loads on first touch", "Markers, clusters and customisable cards", "Brand colours from a style guide", "Works in any framework", "Self-hostable on Cloudflare Workers"],
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: FAQ.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) },
];
---

<Site title="Instant Map: the map that is on the page before your JavaScript" description={description} path="/" overlay preload={[{ href: heroPoster, media: "(min-width: 901px)" }, { href: phonePoster, media: "(max-width: 900px)" }]} schema={schema}>
  <section class="hero" aria-labelledby="hero-title">
    <instant-map id="hero-map" aria-label="Map of 280 sample San Francisco rentals">
      <picture>
        <source media="(max-width: 900px)" srcset={phonePoster} />
        <img src={heroPoster} alt="Map of 280 sample San Francisco rentals" fetchpriority="high" onload="requestAnimationFrame(function () { window.__heroPaint = window.__heroPaint || performance.now(); document.dispatchEvent(new Event('heropaint')); })" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
      </picture>
    </instant-map>
    <p class="handoff" aria-live="polite"><span class="step image">Image<span class="long">, no JavaScript yet</span></span><span class="step live">Live map, drag it</span></p>
    <div class="hero-card">
      <h1 id="hero-title">The map is on the page before your JavaScript is.</h1>
      <p class="lede">Instant Map sends a finished image of your map first, then turns it into a smooth, clickable map the moment someone reaches for it.</p>
      <dl class="proof">
        <div class="lead-stat">
          <dt>First image on screen, this visit</dt>
          <dd><span id="meter-paint">…</span></dd>
          <dd class="cache-note" id="meter-cache" hidden>Your browser had the image cached on this visit.</dd>
        </div>
        <div>
          <dt>JavaScript before the map shows</dt>
          <dd>0 KB</dd>
        </div>
        <div>
          <dt>Interactive</dt>
          <dd id="meter-state">on your first touch</dd>
        </div>
      </dl>
      <div class="install">
        <code>npm install instantmap</code>
        <button type="button" class="copy" data-copy="npm install instantmap">Copy</button>
      </div>
      <div class="actions">
        <a class="button primary" href="/docs/start/quick-start/">Read the quick start</a>
        <button type="button" class="button" data-copy={AGENT_PROMPT}>Copy prompt for your agent</button>
      </div>
      <p class="trust">MIT licence · v{VERSION} · Every framework · <a href={REPO}>Source on GitHub</a></p>
    </div>
  </section>

  <section aria-labelledby="runs-title">
    <h2 id="runs-title">What runs where</h2>
    <div class="steps panel">
      <div>
        <h3>On the server</h3>
        <p>The first image is a JPEG drawn from OpenStreetMap data and your markers, then cached. Use the hosted service or deploy the Worker to your own Cloudflare account.</p>
      </div>
      <div>
        <h3>In the HTML</h3>
        <p>Your page carries that image as a plain <code>&lt;img&gt;</code>, so it shows with the first HTML, before fonts or scripts.</p>
      </div>
      <div>
        <h3>In the browser</h3>
        <p>A {kb(sizes.upfront)} KB loader waits for the first touch, then brings in the {kb(sizes.engine)} KB engine: drag, zoom, clusters, keyboard and cards.</p>
      </div>
    </div>
    <a class="more" href="/docs/start/how-it-works/">How it works, step by step</a>
  </section>

  <section aria-labelledby="explore-title">
    <h2 id="explore-title">See what it does</h2>
    <ul class="tiles big">
      <li><a href="/speed/"><strong>Speed</strong><span>Time a map on your own connection and see what is loaded, and when.</span></a></li>
      <li><a href="/styling/"><strong>Styling and brand colours</strong><span>Build a map from your style guide's colours, or set every colour yourself.</span></a></li>
      <li><a href="/cards/"><strong>Cards</strong><span>The card that opens on a marker: layouts, your colours, or your own markup.</span></a></li>
      <li><a href="/frameworks/"><strong>Frameworks</strong><span>Guides and example apps for ten stacks, from plain HTML to Next.js.</span></a></li>
      <li><a href="/ai/"><strong>AI agents</strong><span>A prompt and Markdown docs so a coding agent can add the map for you.</span></a></li>
      <li><a href="/docs/guides/self-hosting/"><strong>Self-hosting</strong><span>Run the renderer on your own Cloudflare account with your own tiles.</span></a></li>
    </ul>
  </section>

  <section aria-labelledby="faq-title">
    <h2 id="faq-title">Questions and answers</h2>
    <div class="faq panel">
      {FAQ.map(([question, answer], index) => (
        <details open={index === 0}>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
    <a class="more" href="/docs/start/faq/">More answers in the docs</a>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <h2 id="closing-title">Put a map on your page in a minute</h2>
    <div class="install">
      <code>npm install instantmap</code>
      <button type="button" class="copy" data-copy="npm install instantmap">Copy</button>
    </div>
    <a class="button primary" href="/docs/start/quick-start/">Read the quick start</a>
  </section>

  <script>
    import type { InstantMapElement } from "instantmap";
    import { sanFranciscoListings } from "../data/listings.ts";
    import { byId } from "../scripts/shared.ts";

    const map = byId<InstantMapElement>("hero-map");
    map.markers = sanFranciscoListings(280);
    const showPaint = (): void => {
      const painted = (window as { __heroPaint?: number }).__heroPaint;
      if (!painted) return;
      byId("meter-paint").replaceChildren(String(Math.round(painted)), Object.assign(document.createElement("span"), { className: "unit", textContent: "ms" }));
      const poster = performance.getEntriesByType("resource").find((entry) => entry.name.includes("/static?")) as PerformanceResourceTiming | undefined;
      if (poster && poster.transferSize === 0 && poster.decodedBodySize > 0) byId("meter-cache").hidden = false;
    };
    showPaint();
    document.addEventListener("heropaint", showPaint);
    map.addEventListener("interactive", () => (byId("meter-state").textContent = "live now, try dragging it"));
  </script>
</Site>
