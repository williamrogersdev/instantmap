---
import { staticUrl } from "instantmap/server";
import { sanFranciscoListings } from "../data/listings.ts";

const HERO_CENTER: [number, number] = [-122.4295, 37.7668];
const HERO_ZOOM = 13.25;
const listings = sanFranciscoListings(280);
const heroPoster = staticUrl({ src: "", center: HERO_CENTER, zoom: HERO_ZOOM, width: 1280, height: 800, ratio: 2, markers: listings });
const studioPoster = staticUrl({ src: "", center: [-122.4215, 37.7745], zoom: 13.2, width: 960, height: 720, ratio: 2, markers: listings });

const frameworks = [
  ["Next.js", "nextjs"],
  ["React", "react"],
  ["React Router", "react-router"],
  ["Astro", "astro"],
  ["Vue", "vue"],
  ["Nuxt", "nuxt"],
  ["SvelteKit", "sveltekit"],
  ["Angular", "angular"],
  ["Solid", "solid"],
  ["Plain HTML, Rails, Django, PHP", "html"],
];

const agentPrompt = `Add an Instant Map to this project.

1. Read https://instantmap.org/llms.txt, then the framework guide for this project's stack from https://instantmap.org/docs/frameworks/ (append .md to any docs URL for Markdown).
2. Install the package: npm install instantmap
3. Render the map where I ask, with an explicit height, centred on my data, and pass my records as markers: { id, lng, lat, label, title, subtitle, href }.
4. If the framework renders on the server, render the first image on the server as the guide shows, so the map appears before any JavaScript runs.
5. Run the app and check: the image appears, the map moves when dragged, and clicking a marker opens its card. Fix any console errors.`;

const htmlSample = `<script type="module" src="https://instantmap.org/instant-map.js"></script>

<instant-map center="-122.42,37.77" zoom="12" style="height:480px"></instant-map>

<script type="module">
  const map = document.querySelector("instant-map");
  map.markers = await fetch("/api/listings").then((r) => r.json());
  map.addEventListener("markerclick", (event) => console.log(event.detail.marker));
</script>`;

const reactSample = `import { InstantMap } from "instantmap/react";

export function ListingsMap({ listings }) {
  return (
    <InstantMap
      center={[-122.42, 37.77]}
      zoom={12}
      markers={listings}
      style={{ height: 480 }}
      onMarkerClick={(marker) => router.push(marker.href)}
    />
  );
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Instant Map</title>
    <meta name="description" content="An open-source map for the web that paints as one image before any JavaScript runs, then becomes a fast interactive map when touched. One web component for every framework." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href={heroPoster} fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script type="module" src="/instant-map.js"></script>
    <script is:inline>
      try {
        new PerformanceObserver((list) => {
          for (const entry of list.getEntries()) {
            if (entry.element && entry.element.closest && entry.element.closest("#hero-map")) window.__heroPaint = entry.renderTime || entry.startTime;
          }
          document.dispatchEvent(new Event("heropaint"));
        }).observe({ type: "largest-contentful-paint", buffered: true });
      } catch {}
    </script>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" width="26" height="26" />
        Instant Map
      </a>
      <nav aria-label="Main">
        <a href="/docs/start/quick-start/">Docs</a>
        <a href="/docs/frameworks/nextjs/">Frameworks</a>
        <a href="/docs/reference/element/">API</a>
        <a href="https://github.com/williamrogersdev/instantmap">GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <instant-map id="hero-map" center={HERO_CENTER.join(",")} zoom={HERO_ZOOM} aria-label="Map of 280 sample San Francisco rentals">
          <img src={heroPoster} alt="Map of 280 sample San Francisco rentals" fetchpriority="high" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
        </instant-map>
        <div class="hero-card">
          <h1 id="hero-title">The map is on the page before your JavaScript is.</h1>
          <p class="lede">
            Instant Map sends a finished image of your map first. The moment someone reaches for it, it turns into a smooth,
            clickable map of your listings. One web component, every framework, docs written for AI agents to follow.
          </p>
          <div class="install">
            <code>npm install instantmap</code>
            <button type="button" class="copy" data-copy="npm install instantmap">Copy</button>
          </div>
          <div class="actions">
            <a class="button primary" href="/docs/start/quick-start/">Add it to your site</a>
            <button type="button" class="button" data-copy={agentPrompt}>Copy prompt for your agent</button>
          </div>
        </div>
        <dl class="meter" aria-live="polite">
          <div><dt>First image</dt><dd id="meter-paint">measuring</dd></div>
          <div><dt>Script</dt><dd id="meter-script">13 KB, loads after the image</dd></div>
          <div><dt>Map</dt><dd id="meter-state">drag or tap to wake it</dd></div>
        </dl>
      </section>

      <section class="studio" id="studio" aria-labelledby="studio-title">
        <div class="studio-copy">
          <h2 id="studio-title">Make it yours</h2>
          <p>
            Pick a theme, then recolour any part of it. The server paints the first image in the same colours, so nothing
            changes when the map wakes up.
          </p>
          <fieldset class="themes">
            <legend>Theme</legend>
            <label><input type="radio" name="theme" value="daylight" checked /><span class="swatch" style="--a:#f6f4f0;--b:#a6d3f0;--c:#5b3df5"></span>Daylight</label>
            <label><input type="radio" name="theme" value="midnight" /><span class="swatch" style="--a:#161a21;--b:#0c2a47;--c:#a594ff"></span>Midnight</label>
            <label><input type="radio" name="theme" value="paper" /><span class="swatch" style="--a:#f3efe6;--b:#a9c6d6;--c:#3d2fb0"></span>Paper</label>
            <label><input type="radio" name="theme" value="mono" /><span class="swatch" style="--a:#f2f2f2;--b:#cfd6dc;--c:#5b3df5"></span>Mono</label>
          </fieldset>
          <fieldset class="tokens">
            <legend>Colours</legend>
            <label><input type="color" data-token="cluster" />Clusters</label>
            <label><input type="color" data-token="marker" />Price pills</label>
            <label><input type="color" data-token="markerText" />Pill text</label>
            <label><input type="color" data-token="selected" />Selected</label>
            <label><input type="color" data-token="water" />Water</label>
            <label><input type="color" data-token="land" />Land</label>
          </fieldset>
          <div class="presets">
            <button type="button" class="chip" data-preset="">Theme defaults</button>
            <button type="button" class="chip" data-preset="cluster:9f1239,marker:e11d48,accent:e11d48,selected:fde047,selectedText:3f2a00">Rose</button>
            <button type="button" class="chip" data-preset="cluster:134e4a,marker:0f766e,accent:0f766e,water:b9dde0">Harbour</button>
            <button type="button" class="chip" data-preset="cluster:14532d,marker:15803d,accent:15803d,selected:fde047,selectedText:3f2a00">Forest</button>
          </div>
        </div>
        <div class="studio-map">
          <instant-map id="studio-map" center="-122.4215,37.7745" zoom="13.2" aria-label="Map you can restyle with the controls">
            <img src={studioPoster} alt="Map you can restyle with the controls" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
          </instant-map>
          <div class="code">
            <div class="tabs" role="tablist" aria-label="Code for this map">
              <button type="button" role="tab" aria-selected="true" data-tab="html">HTML</button>
              <button type="button" role="tab" aria-selected="false" data-tab="react">React</button>
              <button type="button" role="tab" aria-selected="false" data-tab="agent">Agent prompt</button>
              <button type="button" class="copy" data-copy-target="studio-code">Copy</button>
            </div>
            <pre><code id="studio-code"></code></pre>
          </div>
        </div>
      </section>

      <section class="race" id="race" aria-labelledby="race-title">
        <div class="race-head">
          <h2 id="race-title">Race it against MapLibre, on your connection</h2>
          <p>
            Both lanes load San Francisco at the same size, from nothing, in your browser. The clock stops when the map is fully drawn.
          </p>
          <div class="race-controls">
            <button type="button" class="button primary" id="race-start">Start the race</button>
            <label class="toggle"><input type="checkbox" id="race-fresh" checked /> Fresh image (skip our edge cache)</label>
          </div>
        </div>
        <div class="lanes">
          <figure class="lane" data-lane="instant">
            <figcaption>
              <strong>Instant Map</strong>
              <span class="time" data-time>–</span>
            </figcaption>
            <div class="screen"><p class="idle">Press start</p></div>
            <p class="weight">JavaScript before the map shows: <strong>0 KB</strong></p>
          </figure>
          <figure class="lane" data-lane="maplibre">
            <figcaption>
              <strong>MapLibre GL 6.16</strong>
              <span class="time" data-time>–</span>
            </figcaption>
            <div class="screen"><p class="idle">Press start</p></div>
            <p class="weight">JavaScript before the map shows: <strong>288 KB</strong> gzipped</p>
          </figure>
        </div>
        <p class="fine">
          MapLibre uses the free OpenFreeMap Liberty style. Lanes run one after the other so they never share bandwidth. A second run
          uses your browser cache for both. MapLibre draws vectors and can rotate and tilt; if you need those, use it.
        </p>
      </section>

      <section class="frameworks" aria-labelledby="frameworks-title">
        <h2 id="frameworks-title">Works where you already work</h2>
        <p>It is a standard web component, with a React adapter and a server helper for the first image. Each guide is built from an example app we run.</p>
        <ul>
          {frameworks.map(([name, slug]) => <li><a href={`/docs/frameworks/${slug}/`}>{name}</a></li>)}
        </ul>
        <div class="samples">
          <div class="sample">
            <h3>Any page</h3>
            <pre><code>{htmlSample}</code></pre>
          </div>
          <div class="sample">
            <h3>React and Next.js</h3>
            <pre><code>{reactSample}</code></pre>
          </div>
        </div>
      </section>

      <section class="agents" aria-labelledby="agents-title">
        <div>
          <h2 id="agents-title">Written for the agent doing the work</h2>
          <p>
            Paste this into Claude Code, Cursor or Codex. Every docs page is also plain Markdown at the same address plus
            <code>.md</code>, and the whole manual is one file at <a href="/llms-full.txt">/llms-full.txt</a>.
          </p>
          <ul class="links">
            <li><a href="/llms.txt">llms.txt</a></li>
            <li><a href="/llms-full.txt">llms-full.txt</a></li>
            <li><a href="/docs/start/ai-agents/">Agent guide</a></li>
          </ul>
        </div>
        <div class="prompt">
          <pre><code>{agentPrompt}</code></pre>
          <button type="button" class="button primary" data-copy={agentPrompt}>Copy prompt</button>
        </div>
      </section>
    </main>

    <footer>
      <span>MIT licensed. Map data © OpenStreetMap contributors. Listings on this page are made up.</span>
      <a href="https://github.com/williamrogersdev/instantmap">Source on GitHub</a>
    </footer>

    <script>
      import { sanFranciscoListings } from "../data/listings.ts";
      import { setupLanding } from "../scripts/landing.ts";
      setupLanding(sanFranciscoListings(280));
    </script>
  </body>
</html>

<style is:global>
  :root {
    --wash: #f3f1fb;
    --paper: #ffffff;
    --ink: #160f3d;
    --ink-soft: #554d78;
    --line: #dcd6f0;
    --brand: #5b3df5;
    --brand-ink: #ffffff;
    --signal: #2de0c8;
    --code: #160f3d;
    --code-ink: #e4e0ff;
    --radius-small: 8px;
    --radius-large: 18px;
    --sans: "Schibsted Grotesk", ui-sans-serif, system-ui, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--wash); color: var(--ink); font: 400 17px/1.55 var(--sans); }
  a { color: var(--brand); }
  :focus-visible { outline: 3px solid var(--brand); outline-offset: 2px; }
  h1, h2, h3 { margin: 0; line-height: 1.08; letter-spacing: -0.02em; }
  h2 { font-size: clamp(30px, 4vw, 44px); font-weight: 750; }
  h3 { font-size: 16px; font-weight: 650; letter-spacing: 0; }
  p { margin: 0; }
  code, pre { font-family: var(--mono); }

  .bar { position: absolute; z-index: 5; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 16px clamp(16px, 4vw, 40px); pointer-events: none; }
  .bar > * { pointer-events: auto; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 750; font-size: 18px; color: var(--ink); text-decoration: none; background: var(--paper); padding: 8px 14px 8px 10px; border-radius: 999px; box-shadow: 0 1px 2px #160f3d14, 0 8px 24px #160f3d1a; }
  .bar nav { display: flex; gap: 4px; background: var(--paper); padding: 4px; border-radius: 999px; box-shadow: 0 1px 2px #160f3d14, 0 8px 24px #160f3d1a; }
  .bar nav a { color: var(--ink); text-decoration: none; font-weight: 550; font-size: 15px; padding: 8px 14px; border-radius: 999px; min-height: 40px; display: inline-flex; align-items: center; }
  .bar nav a:hover { background: var(--wash); }

  .hero { position: relative; height: min(100svh, 980px); min-height: 640px; }
  #hero-map { position: absolute; inset: 0; height: 100%; }
  instant-map { --im-font: var(--sans); }
  #hero-map::part(controls) { top: 96px; }
  .hero-card { background: var(--paper); }
  .hero-card { position: absolute; z-index: 3; left: clamp(16px, 4vw, 40px); top: 50%; transform: translateY(-46%); width: min(520px, calc(100% - 32px)); border-radius: var(--radius-large); padding: clamp(22px, 3vw, 34px); box-shadow: 0 2px 4px #160f3d12, 0 24px 60px #160f3d29; }
  .hero-card h1 { font-size: clamp(34px, 4.6vw, 54px); font-weight: 800; letter-spacing: -0.035em; }
  .lede { margin-top: 18px; color: var(--ink-soft); font-size: 18px; max-width: 46ch; }
  .install { margin-top: 24px; display: flex; align-items: center; justify-content: space-between; gap: 8px; background: var(--code); color: var(--code-ink); border-radius: var(--radius-small); padding: 6px 6px 6px 16px; }
  .install code { font-size: 15px; }
  .actions { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 18px; border-radius: var(--radius-small); border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 600 16px var(--sans); text-decoration: none; cursor: pointer; }
  .button:hover { border-color: var(--ink-soft); }
  .button.primary { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
  .button.primary:hover { background: #4a2ee0; }
  .copy { min-height: 36px; min-width: 64px; padding: 0 12px; border: 0; border-radius: 6px; background: #ffffff1a; color: inherit; font: 600 14px var(--sans); cursor: pointer; }
  .copy:hover { background: #ffffff2e; }

  .meter { position: absolute; z-index: 3; right: clamp(16px, 4vw, 40px); bottom: 40px; margin: 0; display: flex; gap: 2px; background: var(--code); color: var(--code-ink); border-radius: 14px; padding: 6px; box-shadow: 0 16px 40px #160f3d40; }
  .meter div { padding: 8px 14px; }
  .meter div + div { border-left: 1px solid #ffffff1f; }
  .meter dt { font-size: 13px; color: #a99fd6; }
  .meter dd { margin: 2px 0 0; font: 500 15px var(--mono); }
  #meter-paint { color: var(--signal); font-size: 22px; line-height: 1.1; }

  section:not(.hero) { padding: clamp(48px, 6vw, 84px) clamp(16px, 4vw, 40px); max-width: 1320px; margin: 0 auto; }

  .studio { display: grid; grid-template-columns: minmax(280px, 380px) 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .studio-copy > p { margin-top: 14px; color: var(--ink-soft); }
  fieldset { border: 0; padding: 0; margin: 28px 0 0; }
  legend { font-weight: 650; font-size: 15px; margin-bottom: 10px; }
  .themes { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .themes label { position: relative; display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 8px 12px; border: 1px solid var(--line); border-radius: var(--radius-small); background: var(--paper); cursor: pointer; font-weight: 550; }
  .themes label:has(input:checked) { border-color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
  .themes input { position: absolute; opacity: 0; }
  .themes label:has(input:focus-visible) { outline: 3px solid var(--brand); outline-offset: 2px; }
  .swatch { width: 30px; height: 30px; border-radius: 50%; background: conic-gradient(var(--a) 0 50%, var(--b) 50% 80%, var(--c) 80%); box-shadow: inset 0 0 0 1px #0000001f; flex: none; }
  .tokens { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .tokens label { display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: 15px; }
  .tokens input { width: 44px; height: 32px; padding: 0; border: 1px solid var(--line); border-radius: 6px; background: none; cursor: pointer; }
  .presets { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--paper); font: 550 14px var(--sans); color: var(--ink); cursor: pointer; }
  .chip:hover { border-color: var(--ink-soft); }
  .studio-map { min-width: 0; }
  #studio-map { height: clamp(380px, 52vw, 560px); border-radius: var(--radius-large); overflow: hidden; box-shadow: 0 2px 4px #160f3d12, 0 24px 60px #160f3d1f; }
  .code { margin-top: 16px; background: var(--code); color: var(--code-ink); border-radius: var(--radius-large); overflow: hidden; }
  .tabs { display: flex; align-items: center; gap: 2px; padding: 8px 8px 0; }
  .tabs [role="tab"] { min-height: 40px; padding: 0 14px; border: 0; border-radius: 8px 8px 0 0; background: none; color: #a99fd6; font: 600 14px var(--sans); cursor: pointer; }
  .tabs [role="tab"][aria-selected="true"] { background: #ffffff12; color: #ffffff; }
  .tabs .copy { margin-left: auto; }
  .code pre, .sample pre, .prompt pre { margin: 0; padding: 18px 20px; overflow: auto; font-size: 13.5px; line-height: 1.6; white-space: pre; }
  .code pre { background: #ffffff0a; max-height: 300px; }

  .race-head { max-width: 760px; }
  .race-head p { margin-top: 14px; color: var(--ink-soft); }
  .race-controls { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .toggle { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 15px; cursor: pointer; }
  .toggle input { width: 20px; height: 20px; accent-color: var(--brand); }
  .lanes { margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .lane { margin: 0; background: var(--paper); border-radius: var(--radius-large); padding: 14px; box-shadow: 0 1px 2px #160f3d12; }
  .lane figcaption { display: flex; align-items: baseline; justify-content: space-between; padding: 4px 6px 12px; }
  .lane strong { font-weight: 650; }
  .time { font: 500 28px var(--mono); letter-spacing: -0.02em; }
  .lane[data-lane="instant"] .time { color: var(--brand); }
  .screen { position: relative; aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden; background: var(--wash); }
  .screen iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .idle { position: absolute; inset: 0; display: grid; place-items: center; color: var(--ink-soft); font-weight: 550; }
  .weight { padding: 12px 6px 2px; font-size: 15px; color: var(--ink-soft); }
  .weight strong { color: var(--ink); }
  .fine { margin-top: 18px; font-size: 14px; color: var(--ink-soft); max-width: 82ch; }

  .frameworks > p { margin-top: 14px; color: var(--ink-soft); max-width: 70ch; }
  .frameworks ul { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .frameworks li a { display: inline-flex; align-items: center; min-height: 46px; padding: 0 18px; border-radius: 999px; background: var(--paper); color: var(--ink); text-decoration: none; font-weight: 600; border: 1px solid var(--line); }
  .frameworks li a:hover { border-color: var(--brand); color: var(--brand); }
  .samples { margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .sample { background: var(--code); color: var(--code-ink); border-radius: var(--radius-large); overflow: hidden; min-width: 0; }
  .sample h3 { padding: 16px 20px 0; color: #ffffff; }

  .agents { display: grid; grid-template-columns: minmax(260px, 420px) 1fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .agents > div > p { margin-top: 14px; color: var(--ink-soft); }
  .agents p code { font-size: 15px; background: var(--paper); padding: 1px 6px; border-radius: 4px; }
  .links { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 600; }
  .links a { display: inline-flex; min-height: 44px; align-items: center; }
  .prompt { background: var(--code); color: var(--code-ink); border-radius: var(--radius-large); overflow: hidden; min-width: 0; }
  .prompt pre { white-space: pre-wrap; font-size: 14px; }
  .prompt .button { margin: 0 20px 20px; }

  footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 32px clamp(16px, 4vw, 40px) 40px; max-width: 1320px; margin: 0 auto; border-top: 1px solid var(--line); font-size: 14px; color: var(--ink-soft); }

  .toast { position: fixed; z-index: 20; left: 50%; bottom: 24px; transform: translate(-50%, 20px); opacity: 0; background: var(--ink); color: #ffffff; padding: 10px 18px; border-radius: 999px; font-weight: 600; transition: opacity 0.2s, transform 0.2s; pointer-events: none; }
  .toast.on { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 900px) {
