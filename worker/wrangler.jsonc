{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instantmap",
  "account_id": "5bc563d42299762f9b48f5dec0531954",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "../site/dist", "binding": "ASSETS", "not_found_handling": "404-page" },
  "rules": [{ "type": "Data", "globs": ["**/*.pbf"], "fallthrough": false }],
  "vars": {
    // A vector tile source in the Protomaps schema. Self-hosting: point this at your own.
    "TILE_URL": "https://www.repackify.com/map-tiles/v1/tiles/{z}/{x}/{y}.mvt"
  },
  "routes": [{ "pattern": "instantmap.org", "custom_domain": true }],
  // Cloudflare keeps finished pictures in front of the Worker and answers repeats without running it. The cache is
  // tiered, so a picture drawn for one visitor is shared with every other location, and simultaneous requests for
  // the same picture are drawn once. Each deployment starts its own cache. With this on, requests for the site's
  // static files are billed as Worker requests too.
  "cache": { "enabled": true },
  // No address may ask for more than 600 uncached pictures a minute at one Cloudflare location. Cached pictures are
  // never limited. The namespace_id is any number unique within your account.
  "ratelimits": [{ "name": "RENDER_LIMIT", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }],
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true },
  "upload_source_maps": true

  // Optional. Keep every rendered tile in R2, so a tile is drawn once for the whole world rather than
  // once per data centre. Create the bucket first: wrangler r2 bucket create instantmap-tiles
  // Give the bucket a lifecycle rule (for example, delete after 90 days) so it cannot grow without bound.
  // "r2_buckets": [{ "binding": "TILE_CACHE", "bucket_name": "instantmap-tiles" }],
}
